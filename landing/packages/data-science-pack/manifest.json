{
  "id": "data-science-pack",
  "name": "Data Science Pack",
  "type": "bundle",
  "version": "1.0.0",
  "description": "Full data science starter pack for SamCode. Installs notebook core, pandas/numpy, and common scientific tooling together.",
  "entry": "index.mjs",
  "runtime": {
    "language": "python"
  },
  "features": [
    "notebook execution",
    "data analysis",
    "visualization",
    "machine learning foundations",
    "model inspection",
    "reporting and exports"
  ],
  "ui": {
    "requirements": ["notebook-toolbar", "analysis-snippets", "visualization-panel", "model-tools"]
  },
  "dependencies": ["python-notebook-core", "pandas-numpy"],
  "includedPackages": [
    "ipykernel",
    "jupyter-client",
    "nbformat",
    "matplotlib",
    "plotly",
    "seaborn",
    "scikit-learn",
    "sympy",
    "pandas",
    "numpy",
    "scipy",
    "statsmodels",
    "openpyxl",
    "xlsxwriter",
    "pyarrow",
    "notebook",
    "jupyterlab"
  ]
}
